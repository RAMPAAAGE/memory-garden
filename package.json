{
  "name": "memory-garden",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "media": "node scripts/prepare-media.mjs",
    "password": "node scripts/set-password.mjs",
    "dev": "vite",
    "app": "vite build && node scripts/run-electron.cjs",
    "typecheck": "tsc",
    "build": "vite build",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "app.memorygarden",
    "productName": "Memory Garden",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**"],
    "asar": true,
    "compression": "store",
    "win": { "target": "portable", "artifactName": "Memory-Garden.exe", "icon": "build/icon.png" }
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/press-start-2p": "^5.1.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/three": "^0.170.0",
    "canvas-confetti": "^1.9.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "heic-convert": "^2.1.0",
    "sharp": "^0.33.5",
    "three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
